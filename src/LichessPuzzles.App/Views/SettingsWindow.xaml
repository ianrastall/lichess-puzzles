<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (style standard 1.0, section 11): one column, sections 32 apart, fields 16 apart, captions 4 below. -->
<Window
    x:Class="Jupiter.LichessPuzzles.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jupiter="using:Jupiter.UI"
    Title="Settings - Lichess Puzzles">

    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" RequestedTheme="Dark">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="32" MaxWidth="{StaticResource JupiterContentMaxWidth}" HorizontalAlignment="Left">

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource JupiterSectionHeadingTextStyle}" Text="Appearance" />
                    <StackPanel Spacing="16">
                        <jupiter:ThemeSetting x:Name="ThemeSetting" />
                        <jupiter:AccentColorSetting x:Name="AccentSetting" />
                        <ComboBox x:Name="BoardThemeBox" Header="Board" SelectionChanged="OnBoardThemeChanged" MinWidth="200" />
                        <ToggleSwitch x:Name="CoordinatesSwitch" Header="Coordinates" Toggled="OnCoordinatesToggled" />
                        <StackPanel Spacing="4">
                            <RadioButtons x:Name="AnimationChoice" Header="Move animation" SelectionChanged="OnAnimationChanged" MaxColumns="3">
                                <x:String>Off</x:String>
                                <x:String>Fast</x:String>
                                <x:String>Normal</x:String>
                            </RadioButtons>
                            <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" Text="Moves are not animated while Windows animation effects are turned off." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource JupiterSectionHeadingTextStyle}" Text="Puzzles" />
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="ThemesSwitch" Header="Show themes while solving" Toggled="OnThemesToggled" />
                            <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" Text="Themes can give the solution away; when off they are shown once the puzzle ends." />
                        </StackPanel>
                        <ComboBox x:Name="DelayBox" Header="Opponent's move delay" SelectionChanged="OnDelayChanged" MinWidth="200" />
                        <ToggleSwitch x:Name="AutoNextSwitch" Header="Go to the next puzzle after a clean solve" Toggled="OnAutoNextToggled" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource JupiterSectionHeadingTextStyle}" Text="Evaluation" />
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="EvaluationSwitch" Header="Enable evaluation" Toggled="OnEvaluationToggled" />
                            <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" Text="A small built-in engine shows a score and its best line once the puzzle ends. It is a guide, not an authority." />
                        </StackPanel>
                        <ToggleSwitch x:Name="EvaluationSolvingSwitch" Header="Show while solving" Toggled="OnEvaluationSolvingToggled" />
                        <ComboBox x:Name="EvaluationTimeBox" Header="Time per position" SelectionChanged="OnEvaluationTimeChanged" MinWidth="200" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource JupiterSectionHeadingTextStyle}" Text="Storage" />
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource JupiterFieldLabelTextStyle}" Text="Data folder" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataFolderText" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Data folder" />
                                <Button Grid.Column="1" Content="Show folder" Click="OnShowFolder" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Style="{StaticResource JupiterCaptionTextStyle}" Text="Download puzzle files from Lichess when you choose, then use File > Import puzzle file to install them. Imported files are kept." />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
