<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jupiter.LichessPuzzles.App.Views.FilterPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jupiter.LichessPuzzles.App.ViewModels"
    xmlns:views="using:Jupiter.LichessPuzzles.App.Views"
    xmlns:controls="using:Jupiter.LichessPuzzles.App.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:ThemeGroupRow">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,8,0,0">
                <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" Style="{StaticResource JupiterSmallIconStyle}" Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource JupiterCaptionStrongTextStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ThemeTemplate" x:DataType="vm:ThemeRow">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource JupiterCommandIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" VerticalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <!-- Secondary, not quiet: the row can be hovered (standard 3.2). -->
                <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <views:ThemeRowTemplateSelector x:Key="ThemeRowSelector" Group="{StaticResource GroupTemplate}" Theme="{StaticResource ThemeTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource JupiterSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: match count and reset -->
        <Grid Padding="16,12,8,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MatchCount" Text="{x:Bind ViewModel.MatchText, Mode=OneWay}" Style="{StaticResource JupiterPaneHeadingTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <HyperlinkButton Grid.Column="1" Content="Reset filters" Command="{x:Bind ViewModel.ResetCommand}"
                             IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}" Padding="4" />
            <Button x:Name="CloseOverlayButton" Grid.Column="2" Visibility="Collapsed" Click="OnCloseOverlay" Style="{StaticResource JupiterSubtleButtonStyle}"
                    AutomationProperties.Name="Close filters" ToolTipService.ToolTip="Close filters (Ctrl+Shift+F)">
                <FontIcon Glyph="&#xE711;" Style="{StaticResource JupiterSmallIconStyle}" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
            <StackPanel Padding="16,0,16,24" Spacing="16">
                <TextBlock Text="Filters are available once puzzles are installed." Style="{StaticResource JupiterCaptionTextStyle}"
                           Visibility="{x:Bind NotAvailable(ViewModel.IsAvailable), Mode=OneWay}" />

                <!-- Presets -->
                <DropDownButton x:Name="PresetButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="{x:Bind ViewModel.PresetButtonText, Mode=OneWay}"
                                ToolTipService.ToolTip="Apply, save, rename or delete filter presets">
                    <TextBlock Text="{x:Bind ViewModel.PresetButtonText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="PresetMenu" Opening="OnPresetMenuOpening" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Rating -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:NumericTextBox x:Name="RatingFrom" Header="Rating from" Value="{x:Bind ViewModel.RatingMin, Mode=TwoWay}"
                                   PlaceholderText="Any"
                                   Minimum="0" Maximum="4000" />
                        <controls:NumericTextBox Grid.Column="1" Header="to" Value="{x:Bind ViewModel.RatingMax, Mode=TwoWay}"
                                   PlaceholderText="Any"
                                   Minimum="0" Maximum="4000" AutomationProperties.Name="Rating to" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.RatingRange, Mode=OneWay}" Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RatingNote, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                               Foreground="{ThemeResource JupiterWarningBrush}" Visibility="{x:Bind HasText(ViewModel.RatingNote), Mode=OneWay}" />
                </StackPanel>

                <!-- Choosing puzzles -->
                <StackPanel Spacing="8">
                    <RadioButtons Header="Choose puzzles" SelectedIndex="{x:Bind ViewModel.ChooseIndex, Mode=TwoWay}" MaxColumns="2">
                        <x:String>At random</x:String>
                        <x:String>Near my rating</x:String>
                    </RadioButtons>
                    <StackPanel Spacing="4" Visibility="{x:Bind Shown(ViewModel.IsNearRating), Mode=OneWay}">
                        <controls:NumericTextBox Header="Difficulty offset, −600 to 600" Value="{x:Bind ViewModel.DifficultyOffset, Mode=TwoWay}"
                                   Minimum="-600" Maximum="600" />
                        <RadioButtons Header="Rating range" SelectedIndex="{x:Bind ViewModel.RatingWindowIndex, Mode=TwoWay}" MaxColumns="3">
                            <x:String>±75</x:String>
                            <x:String>±150</x:String>
                            <x:String>±300</x:String>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind ViewModel.TargetText, Mode=OneWay}" Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                    </StackPanel>
                    <CheckBox Content="Skip puzzles this player has played" IsChecked="{x:Bind ViewModel.SkipPlayed, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <RadioButtons Header="Short-mate screening" SelectedIndex="{x:Bind ViewModel.ScreeningIndex, Mode=TwoWay}" MaxColumns="1">
                        <x:String>Off</x:String>
                        <x:String>Exclude mate in one</x:String>
                        <x:String>Exclude mate in one or two</x:String>
                    </RadioButtons>
                    <TextBlock Text="Checks the position before showing it. Short mates can still be difficult; choose the exclusions you want. The original database is kept." Style="{StaticResource JupiterCaptionTextStyle}" />
                    <CheckBox Content="Skip shallow engine solutions" IsChecked="{x:Bind ViewModel.SkipShallowSolutions, Mode=TwoWay}" />
                    <TextBlock Text="Experimental. Skips puzzles when the small engine consistently finds every solution move at shallow depths. This is not a human difficulty rating." Style="{StaticResource JupiterCaptionTextStyle}" />
                    <TextBlock Text="Filter counts are before screening and rating matching." Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                </StackPanel>

                <!-- Themes -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Themes" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                    <TextBox PlaceholderText="Find theme" Text="{x:Bind ViewModel.ThemeSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Find theme" />
                    <RadioButtons Header="Included themes must" SelectedIndex="{x:Bind ViewModel.MatchModeIndex, Mode=TwoWay}" MaxColumns="2">
                        <x:String>Any</x:String>
                        <x:String>All</x:String>
                    </RadioButtons>
                    <ListView x:Name="ThemeList" ItemsSource="{x:Bind ViewModel.ThemeRows}" ItemTemplateSelector="{StaticResource ThemeRowSelector}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnThemeClick"
                              AutomationProperties.Name="Themes: select to cycle include, exclude, not used"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource JupiterCompactListViewItemStyle}">
                                <Setter Property="Padding" Value="8,0,8,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock Text="Select a theme to include it; select again to exclude it." Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                </StackPanel>

                <!-- Opening -->
                <StackPanel Spacing="8">
                    <AutoSuggestBox x:Name="OpeningBox" Header="Opening" PlaceholderText="Search families and variations"
                                    TextChanged="OnOpeningTextChanged" SuggestionChosen="OnOpeningChosen" QuerySubmitted="OnOpeningSubmitted"
                                    UpdateTextOnSelect="False">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OpeningSuggestion">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource JupiterCaptionTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Openings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OpeningToken">
                                <Grid ColumnSpacing="4" Padding="8,0,0,0" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource JupiterRaisedBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource JupiterSubtleButtonStyle}"
                                            Click="OnRemoveOpening" Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="{x:Bind RemoveName}">
                                        <FontIcon Glyph="&#xE711;" Style="{StaticResource JupiterSmallIconStyle}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Puzzles without an opening tag are excluded while an opening is chosen." Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                </StackPanel>

                <!-- Side and length -->
                <ComboBox Header="Side to solve" SelectedIndex="{x:Bind ViewModel.SideIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <x:String>Either</x:String>
                    <x:String>White</x:String>
                    <x:String>Black</x:String>
                </ComboBox>

                <StackPanel Spacing="4">
                    <TextBlock Text="Solution length, in the solver's moves" Style="{StaticResource JupiterFieldLabelTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:NumericTextBox Header="From" Value="{x:Bind ViewModel.LengthMin, Mode=TwoWay}" PlaceholderText="1"
                                   Minimum="1" Maximum="17"
                                   AutomationProperties.Name="Solution length from" />
                        <controls:NumericTextBox Grid.Column="1" Header="To" Value="{x:Bind ViewModel.LengthMax, Mode=TwoWay}" PlaceholderText="17"
                                   Minimum="1" Maximum="17"
                                   AutomationProperties.Name="Solution length to" />
                    </Grid>
                </StackPanel>

                <!-- Quality -->
                <Expander Header="Quality" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind ViewModel.QualityExpanded, Mode=TwoWay}">
                    <StackPanel Spacing="12">
                        <controls:NumericTextBox Header="Maximum rating deviation, 0 to 500" Value="{x:Bind ViewModel.MaxDeviation, Mode=TwoWay}" PlaceholderText="Any"
                                   Minimum="0" Maximum="500" />
                        <controls:NumericTextBox Header="Minimum popularity, −100 to 100" Value="{x:Bind ViewModel.MinPopularity, Mode=TwoWay}" PlaceholderText="Any"
                                   Minimum="-100" Maximum="100" />
                        <controls:NumericTextBox Header="Minimum plays" Value="{x:Bind ViewModel.MinPlays, Mode=TwoWay}" PlaceholderText="Any"
                                   Minimum="0" Maximum="10000000" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
