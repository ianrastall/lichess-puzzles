<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jupiter.LichessPuzzles.App.Views.PuzzlePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jupiter.LichessPuzzles.App.ViewModels"
    xmlns:views="using:Jupiter.LichessPuzzles.App.Views">

    <UserControl.Resources>
        <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource JupiterSubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- Sortable column headers: caption-size secondary text (standard section 4). -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource JupiterSubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,0,4,0" />
            <Setter Property="FontSize" Value="{StaticResource JupiterCaptionFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource JupiterSecondaryTextBrush}" />
        </Style>
        <DataTemplate x:Key="MoveRowTemplate" x:DataType="vm:MoveRow">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource JupiterQuietTextBrush}" />
                <Button Grid.Column="1" Style="{StaticResource MoveButtonStyle}"
                        Content="{x:Bind White.San}" Command="{x:Bind White.SelectCommand}"
                        Visibility="{x:Bind views:PuzzlePane.Shown(White)}"
                        Background="{x:Bind views:PuzzlePane.CurrentBackground(White.IsCurrent), Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="…" Margin="8,0" VerticalAlignment="Center" Foreground="{ThemeResource JupiterQuietTextBrush}"
                           Visibility="{x:Bind views:PuzzlePane.Placeholder(White)}" />
                <Button Grid.Column="2" Style="{StaticResource MoveButtonStyle}"
                        Content="{x:Bind Black.San}" Command="{x:Bind Black.SelectCommand}"
                        Visibility="{x:Bind views:PuzzlePane.Shown(Black)}"
                        Background="{x:Bind views:PuzzlePane.CurrentBackground(Black.IsCurrent), Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MoveRow">
            <Grid Padding="8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource JupiterSeparatorBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Puzzle starts" Style="{StaticResource JupiterQuietCaptionTextStyle}" />
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource JupiterSeparatorBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <views:MoveRowTemplateSelector x:Key="MoveRowSelector" Move="{StaticResource MoveRowTemplate}" Marker="{StaticResource MarkerTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource JupiterSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Player rating remains visible in both puzzle and history views. -->
            <StackPanel Grid.Row="0" Spacing="8" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,0,0,1" Padding="16,12,16,12">
                <TextBlock Text="Player rating" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DropDownButton x:Name="PlayerButton" Content="{x:Bind Player.Name, Mode=OneWay}" Padding="8,4" MaxWidth="200"
                                    AutomationProperties.Name="Player" ToolTipService.ToolTip="Switch or manage players">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="PlayerMenu" Opening="OnPlayerMenuOpening" Placement="TopEdgeAlignedLeft" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Grid.Column="1" Text="{x:Bind Player.RatingText, Mode=OneWay}" Style="{StaticResource JupiterSectionHeadingTextStyle}" VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind Player.RatingTooltip, Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind Player.RatingTooltip, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Player.ChangeText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"
                               AutomationProperties.Name="{x:Bind Player.ChangeName, Mode=OneWay}" />
                </Grid>
                <TextBlock Text="{x:Bind Player.RatingStatus, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch IsOn="{x:Bind Player.Rated, Mode=TwoWay}" OnContent="Rated" OffContent="Rated" MinWidth="0"
                                  ToolTipService.ToolTip="A first attempt at a puzzle counts toward the rating; the first mistake, hint or solution makes it a loss" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Player.TodayText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

        <SelectorBar x:Name="Views" Grid.Row="1" Margin="8,4,8,0" SelectionChanged="OnViewChanged">
            <SelectorBarItem x:Name="PuzzleItem" Text="Puzzle" IsSelected="True" ToolTipService.ToolTip="Puzzle (Ctrl+1)" />
            <SelectorBarItem x:Name="HistoryItem" Text="History" ToolTipService.ToolTip="History (Ctrl+2)" />
        </SelectorBar>

        <!-- Puzzle view -->
        <Grid x:Name="PuzzleView" Grid.Row="2" Padding="16,8,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource JupiterSectionHeadingTextStyle}" IsTextSelectionEnabled="True"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton Grid.Column="1" Content="Open on lichess.org" Click="OnOpenLichess" Padding="4,0"
                                     Visibility="{x:Bind views:PuzzlePane.Visible(ViewModel.HasPuzzle), Mode=OneWay}"
                                     ToolTipService.ToolTip="Open this puzzle on lichess.org in your browser" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.Facts, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.Opening, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                           Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.Opening), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Themes, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}"
                           Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.Themes), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ThemesNote, Mode=OneWay}" Style="{StaticResource JupiterQuietCaptionTextStyle}"
                           Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.ThemesNote), Mode=OneWay}" />
            </StackPanel>

            <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False"
                     Title="{x:Bind ViewModel.PromptTitle, Mode=OneWay}" Message="{x:Bind ViewModel.PromptMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.PromptSeverity, Mode=OneWay}"
                     Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.PromptTitle), Mode=OneWay}"
                     AutomationProperties.LiveSetting="Assertive" />

            <Border Grid.Row="2" Background="{ThemeResource JupiterInputBrush}" BorderBrush="{ThemeResource JupiterSeparatorBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4" MinHeight="80">
                <ListView x:Name="MoveList" ItemsSource="{x:Bind ViewModel.Moves}" ItemTemplateSelector="{StaticResource MoveRowSelector}"
                          SelectionMode="None" AutomationProperties.Name="Moves">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Hint" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.HintCommand}"
                        IsEnabled="{x:Bind ViewModel.CanHint, Mode=OneWay}" ToolTipService.ToolTip="Highlight the piece to move (Ctrl+H)" />
                <Button Grid.Column="1" Content="Show solution" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ShowSolutionCommand}"
                        IsEnabled="{x:Bind ViewModel.CanShowSolution, Mode=OneWay}" ToolTipService.ToolTip="Play the rest of the solution (Ctrl+Shift+H)" />
                <Button Grid.Row="1" Content="Retry" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RetryCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRetry, Mode=OneWay}" ToolTipService.ToolTip="Start this puzzle again, unrated (Ctrl+R)" />
                <Button x:Name="NextButton" Grid.Row="1" Grid.Column="1" Content="Next puzzle" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NextCommand}"
                        IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.NextTooltip, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                           Style="{StaticResource JupiterCaptionTextStyle}" />
            </Grid>

            <!-- Evaluation -->
            <StackPanel Grid.Row="4" Spacing="4" Visibility="{x:Bind views:PuzzlePane.Visible(Evaluation.IsVisible), Mode=OneWay}"
                        BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid>
                    <TextBlock Text="Evaluation" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                    <TextBlock Text="{x:Bind Evaluation.ScoreText, Mode=OneWay}" Style="{StaticResource JupiterBodyStrongTextStyle}" HorizontalAlignment="Right"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <TextBlock Text="{x:Bind Evaluation.LineText, Mode=OneWay}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Evaluation.DetailText, Mode=OneWay}" Style="{StaticResource JupiterQuietCaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- History view -->
        <Grid x:Name="HistoryView" Grid.Row="2" Padding="16,8,16,16" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox SelectedIndex="{x:Bind History.ResultFilter, Mode=TwoWay}" AutomationProperties.Name="Show results" MinWidth="170">
                <x:String>All results</x:String>
                <x:String>Solved</x:String>
                <x:String>Solved with help</x:String>
                <x:String>Failed</x:String>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="{x:Bind History.TotalsText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" />
            <Grid Grid.Row="2" ColumnSpacing="4" Padding="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.7*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButtonStyle}" Content="Played" Tag="Played" Click="OnSortHistory" />
                <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Content="Puzzle" Tag="Puzzle" Click="OnSortHistory" />
                <Button Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" Content="Rating" Tag="Rating" Click="OnSortHistory" />
                <Button Grid.Column="3" Style="{StaticResource HeaderButtonStyle}" Content="Result" Tag="Result" Click="OnSortHistory" />
                <Button Grid.Column="4" Style="{StaticResource HeaderButtonStyle}" Content="±" Tag="Change" Click="OnSortHistory"
                        AutomationProperties.Name="Rating change" ToolTipService.ToolTip="Rating change" />
            </Grid>
            <ListView x:Name="HistoryList" Grid.Row="3" ItemsSource="{x:Bind History.Rows}" SelectionMode="Single"
                      DoubleTapped="OnHistoryDoubleTapped" KeyDown="OnHistoryKeyDown" AutomationProperties.Name="Played puzzles">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRow">
                        <Grid ColumnSpacing="4" AutomationProperties.Name="{x:Bind AutomationName}"
                              ToolTipService.ToolTip="{x:Bind views:PuzzlePane.HistoryTooltip(Mistakes, Hints, Time)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.7*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open puzzle" Tag="{x:Bind PuzzleId}" Click="OnHistoryOpen" />
                                    <MenuFlyoutItem Text="Open on lichess.org" Tag="{x:Bind PuzzleId}" Click="OnHistoryLichess" />
                                    <MenuFlyoutItem Text="Copy puzzle id" Tag="{x:Bind PuzzleId}" Click="OnHistoryCopy" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock Text="{x:Bind Played}" Style="{StaticResource JupiterCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PuzzleId}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Rating}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Result}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Change}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="3" Text="{x:Bind History.EmptyText, Mode=OneWay}" Style="{StaticResource JupiterCaptionTextStyle}" Margin="12,8"
                       Visibility="{x:Bind views:PuzzlePane.Visible(History.IsEmpty), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
