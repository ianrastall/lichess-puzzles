<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jupiter.LichessPuzzles.App.Views.PuzzlePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jupiter.LichessPuzzles.App.ViewModels"
    xmlns:views="using:Jupiter.LichessPuzzles.App.Views">

    <UserControl.Resources>
        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <DataTemplate x:Key="MoveRowTemplate" x:DataType="vm:MoveRow">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource JupiterQuietTextBrush}" />
                <Button Grid.Column="1" Style="{StaticResource MoveButtonStyle}"
                        Content="{x:Bind White.San}" Command="{x:Bind White.SelectCommand}"
                        Visibility="{x:Bind views:PuzzlePane.Shown(White)}"
                        Background="{x:Bind views:PuzzlePane.CurrentBackground(White.IsCurrent), Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="…" Margin="8,0" VerticalAlignment="Center" Foreground="{ThemeResource JupiterQuietTextBrush}"
                           Visibility="{x:Bind views:PuzzlePane.Placeholder(White)}" />
                <Button Grid.Column="2" Style="{StaticResource MoveButtonStyle}"
                        Content="{x:Bind Black.San}" Command="{x:Bind Black.SelectCommand}"
                        Visibility="{x:Bind views:PuzzlePane.Shown(Black)}"
                        Background="{x:Bind views:PuzzlePane.CurrentBackground(Black.IsCurrent), Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MoveRow">
            <Grid Padding="8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource JupiterSeparatorBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Puzzle starts" FontSize="12" Foreground="{ThemeResource JupiterQuietTextBrush}" />
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource JupiterSeparatorBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <views:MoveRowTemplateSelector x:Key="MoveRowSelector" Move="{StaticResource MoveRowTemplate}" Marker="{StaticResource MarkerTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource JupiterSurfaceBrush}" Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Puzzle header -->
        <StackPanel Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True"
                           TextTrimming="CharacterEllipsis" />
                <HyperlinkButton Grid.Column="1" Content="Open on lichess.org" Click="OnOpenLichess" Padding="4,2"
                                 Visibility="{x:Bind views:PuzzlePane.Visible(ViewModel.HasPuzzle), Mode=OneWay}"
                                 ToolTipService.ToolTip="Open this puzzle on lichess.org in your browser" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Facts, Mode=OneWay}" Style="{StaticResource CaptionStyle}" IsTextSelectionEnabled="True" />
            <TextBlock Text="{x:Bind ViewModel.Opening, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                       Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.Opening), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Themes, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                       Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.Themes), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ThemesNote, Mode=OneWay}" Style="{StaticResource QuietCaptionStyle}"
                       Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.ThemesNote), Mode=OneWay}" />
        </StackPanel>

        <!-- Prompt: always states what to do next -->
        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False"
                 Title="{x:Bind ViewModel.PromptTitle, Mode=OneWay}" Message="{x:Bind ViewModel.PromptMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.PromptSeverity, Mode=OneWay}"
                 Visibility="{x:Bind views:PuzzlePane.HasText(ViewModel.PromptTitle), Mode=OneWay}"
                 AutomationProperties.LiveSetting="Assertive" />

        <!-- Move list -->
        <Border Grid.Row="2" Background="{ThemeResource JupiterInputBrush}" BorderBrush="{ThemeResource JupiterSeparatorBrush}"
                BorderThickness="1" CornerRadius="6" Padding="4">
            <ListView x:Name="MoveList" ItemsSource="{x:Bind ViewModel.Moves}" ItemTemplateSelector="{StaticResource MoveRowSelector}"
                      SelectionMode="None" AutomationProperties.Name="Moves">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Hint" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.HintCommand}"
                    IsEnabled="{x:Bind ViewModel.CanHint, Mode=OneWay}" ToolTipService.ToolTip="Highlight the piece to move (Ctrl+H)" />
            <Button Grid.Column="1" Content="Show solution" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ShowSolutionCommand}"
                    IsEnabled="{x:Bind ViewModel.CanShowSolution, Mode=OneWay}" ToolTipService.ToolTip="Play the rest of the solution (Ctrl+Shift+H)" />
            <Button Grid.Row="1" Content="Retry" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RetryCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRetry, Mode=OneWay}" ToolTipService.ToolTip="Start this puzzle again (Ctrl+R)" />
            <Button x:Name="NextButton" Grid.Row="1" Grid.Column="1" Content="Next puzzle" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.NextTooltip, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
