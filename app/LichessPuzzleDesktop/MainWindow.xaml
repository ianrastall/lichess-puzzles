<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LichessPuzzleDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LichessPuzzleDesktop"
    xmlns:controls="using:LichessPuzzleDesktop.Controls"
    xmlns:vm="using:LichessPuzzleDesktop.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MoveButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="15" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="OnStepBack" />
            <KeyboardAccelerator Key="Right" Invoked="OnStepForward" />
            <KeyboardAccelerator Key="Home" Invoked="OnStepFirst" />
            <KeyboardAccelerator Key="End" Invoked="OnStepLast" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNextPuzzle" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenDatabase" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSavePgn" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="&#x265E;" FontFamily="Segoe UI Symbol" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="Lichess Puzzle Desktop" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: database, filters, progress -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Player" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.RatingChange, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" ToolTipService.ToolTip="Rating change from the last rated puzzle" />
                            </Grid>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Players}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPlayer, Mode=TwoWay}"
                                      IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlayerOption">
                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Bind ViewModel.PlayerSummary, Mode=OneWay}" Style="{StaticResource Secondary}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="New…">
                                    <Button.Flyout>
                                        <Flyout x:Name="NewPlayerFlyout">
                                            <StackPanel Spacing="12" Width="240">
                                                <TextBox Header="New player" PlaceholderText="Name" MaxLength="40"
                                                         Text="{x:Bind ViewModel.PlayerNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="Add player" Style="{StaticResource AccentButtonStyle}"
                                                        Command="{x:Bind ViewModel.AddPlayerCommand}" Click="OnPlayerFlyoutAction" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="Rename…">
                                    <Button.Flyout>
                                        <Flyout x:Name="RenamePlayerFlyout">
                                            <StackPanel Spacing="12" Width="240">
                                                <TextBox Header="Rename player" PlaceholderText="New name" MaxLength="40"
                                                         Text="{x:Bind ViewModel.PlayerNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="Rename" Style="{StaticResource AccentButtonStyle}"
                                                        Command="{x:Bind ViewModel.RenamePlayerCommand}" Click="OnPlayerFlyoutAction" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="Delete…" IsEnabled="{x:Bind ViewModel.CanDeletePlayer, Mode=OneWay}">
                                    <Button.Flyout>
                                        <Flyout x:Name="DeletePlayerFlyout">
                                            <StackPanel Spacing="12" MaxWidth="240">
                                                <TextBlock TextWrapping="Wrap" Text="Delete this player, with their rating and history? This cannot be undone." />
                                                <Button Content="Delete player" Command="{x:Bind ViewModel.DeletePlayerCommand}" Click="OnPlayerFlyoutAction" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <CheckBox Content="Rated" IsChecked="{x:Bind ViewModel.IsRated, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Each new puzzle counts as a Glicko-2 rated game against the puzzle. The first mistake or hint counts as a loss." />
                            <CheckBox Content="Match puzzles to my rating" IsChecked="{x:Bind ViewModel.MatchRating, Mode=TwoWay}" />
                            <ComboBox Header="Difficulty" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind ViewModel.DifficultyIndex, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.MatchRating, Mode=OneWay}">
                                <x:String>Easiest (−600)</x:String>
                                <x:String>Easier (−300)</x:String>
                                <x:String>Normal</x:String>
                                <x:String>Harder (+300)</x:String>
                                <x:String>Hardest (+600)</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Database" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.DatabaseName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.DatabaseSummary, Mode=OneWay}" Style="{StaticResource Secondary}"
                                       Visibility="{x:Bind local:Ui.ShowText(ViewModel.DatabaseSummary), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Visibility="{x:Bind local:Ui.Show(ViewModel.IsSampleDatabase), Mode=OneWay}"
                                       Text="This is the bundled sample. For the full set, download lichess_db_puzzle.csv.zst from database.lichess.org, decompress it and open the .csv file." />
                            <Button Content="Open database…" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.OpenDatabaseCommand}"
                                    IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10" IsHitTestVisible="{x:Bind ViewModel.HasDatabase, Mode=OneWay}">
                            <TextBlock Text="Filters" Style="{StaticResource CardTitle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Header="Rating from" Minimum="0" Maximum="4000" SmallChange="50" LargeChange="200"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.RatingMin, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="to" Minimum="0" Maximum="4000" SmallChange="50" LargeChange="200"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.RatingMax, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Header="Min popularity" Minimum="-100" Maximum="100" SmallChange="5"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.PopularityMin, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="Min plays" Minimum="0" Maximum="1000000" SmallChange="100"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{x:Bind ViewModel.PlaysMin, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Themes (all must match)" />
                                <DropDownButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Content="{x:Bind ViewModel.ThemeSummary, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <ListView ItemsSource="{x:Bind ViewModel.Themes}" SelectionMode="None"
                                                      Width="290" MaxHeight="460" Margin="-8">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ThemeOption">
                                                        <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>

                            <ComboBox Header="Opening" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Openings}"
                                      SelectedItem="{x:Bind ViewModel.SelectedOpening, Mode=TwoWay}" />

                            <CheckBox Content="Skip puzzles I've already played"
                                      IsChecked="{x:Bind ViewModel.SkipPlayed, Mode=TwoWay}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Apply filters" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ApplyFilterCommand}"
                                        IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button Grid.Column="1" Content="Reset" Command="{x:Bind ViewModel.ResetFiltersCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Go to puzzle" Style="{StaticResource CardTitle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Puzzle id, e.g. 00sHx"
                                         Text="{x:Bind ViewModel.PuzzleIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Go" Command="{x:Bind ViewModel.GoToPuzzleCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Progress" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" Style="{StaticResource Secondary}" />
                            <Button Content="Clear history…" IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="12" MaxWidth="240">
                                            <TextBlock TextWrapping="Wrap" Text="Forget every puzzle you have played? This cannot be undone." />
                                            <Button Content="Clear history" Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Centre: evaluation bar, board, navigation -->
            <Grid Grid.Column="1" RowSpacing="12" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="18" CornerRadius="4" BorderThickness="1" Margin="0,8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.IsEvalVisible), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.EvalText, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{x:Bind local:Ui.StarRest(ViewModel.EvalWhiteFraction), Mode=OneWay}" />
                            <RowDefinition Height="{x:Bind local:Ui.Star(ViewModel.EvalWhiteFraction), Mode=OneWay}" />
                        </Grid.RowDefinitions>
                        <Rectangle Fill="#FF2B2B2B" />
                        <Rectangle Grid.Row="1" Fill="#FFF2F2F2" />
                    </Grid>
                </Border>

                <controls:ChessBoard Grid.Column="1"
                                     Snapshot="{x:Bind ViewModel.Board, Mode=OneWay}"
                                     Interaction="{x:Bind ViewModel}" />

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Command="{x:Bind ViewModel.StepFirstCommand}" IsEnabled="{x:Bind ViewModel.CanStepBack, Mode=OneWay}" ToolTipService.ToolTip="First position (Home)">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.StepBackCommand}" IsEnabled="{x:Bind ViewModel.CanStepBack, Mode=OneWay}" ToolTipService.ToolTip="Back (Left arrow)">
                        <FontIcon Glyph="&#xE76B;" FontSize="16" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.StepForwardCommand}" IsEnabled="{x:Bind ViewModel.CanStepForward, Mode=OneWay}" ToolTipService.ToolTip="Forward (Right arrow)">
                        <FontIcon Glyph="&#xE76C;" FontSize="16" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.StepLastCommand}" IsEnabled="{x:Bind ViewModel.CanStepForward, Mode=OneWay}" ToolTipService.ToolTip="Latest position (End)">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.FlipBoardCommand}" IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}" ToolTipService.ToolTip="Flip board" Margin="16,0,0,0">
                        <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right: puzzle, notation, actions, evaluation -->
            <Grid Grid.Column="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.PuzzleTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.PuzzleFacts, Mode=OneWay}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{x:Bind ViewModel.PuzzleOpening, Mode=OneWay}" Style="{StaticResource Secondary}"
                                   Visibility="{x:Bind local:Ui.ShowText(ViewModel.PuzzleOpening), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False"
                         Severity="{x:Bind local:Ui.Severity(ViewModel.StatusKind), Mode=OneWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Moves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MoveRowViewModel">
                                    <Grid ColumnSpacing="4" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button Grid.Column="1" Style="{StaticResource MoveButton}"
                                                Content="{x:Bind White.San}" Command="{x:Bind White.SelectCommand}"
                                                IsEnabled="{x:Bind White.IsMove}"
                                                Background="{x:Bind local:Ui.CurrentMoveBackground(White.IsCurrent), Mode=OneWay}"
                                                Foreground="{x:Bind local:Ui.MoveForeground(White.IsCurrent), Mode=OneWay}" />
                                        <Button Grid.Column="2" Style="{StaticResource MoveButton}"
                                                Content="{x:Bind Black.San}" Command="{x:Bind Black.SelectCommand}"
                                                IsEnabled="{x:Bind Black.IsMove}"
                                                Visibility="{x:Bind local:Ui.ShowText(Black.San)}"
                                                Background="{x:Bind local:Ui.CurrentMoveBackground(Black.IsCurrent), Mode=OneWay}"
                                                Foreground="{x:Bind local:Ui.MoveForeground(Black.IsCurrent), Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="Hint" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.HintCommand}"
                            IsEnabled="{x:Bind ViewModel.IsInProgress, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Show solution" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ShowSolutionCommand}"
                            IsEnabled="{x:Bind ViewModel.IsInProgress, Mode=OneWay}" />
                    <Button Grid.Row="1" Content="Retry" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RetryCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}" />
                    <Button x:Name="NextPuzzleButton" Grid.Row="1" Grid.Column="1" Content="Next puzzle" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.NextPuzzleCommand}" IsEnabled="{x:Bind ViewModel.HasDatabase, Mode=OneWay}"
                            ToolTipService.ToolTip="Ctrl+N" />
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Evaluation" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <ToggleSwitch HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,-6,-12,-6"
                                          IsOn="{x:Bind ViewModel.IsEngineEnabled, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Spacing="4" Visibility="{x:Bind local:Ui.Show(ViewModel.IsEvalVisible), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.EvalText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.EvalLine, Mode=OneWay}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.EvalDetail, Mode=OneWay}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <CheckBox Content="Show while solving" IsChecked="{x:Bind ViewModel.EvalWhileSolving, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsEngineEnabled, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Themes" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.PuzzleThemes, Mode=OneWay}" Style="{StaticResource Secondary}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DropDownButton Content="Export" HorizontalAlignment="Stretch">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="Copy PGN" Command="{x:Bind ViewModel.CopyPgnCommand}" IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Copy FEN" Command="{x:Bind ViewModel.CopyFenCommand}" IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Save puzzle as PGN…" Command="{x:Bind ViewModel.SavePgnCommand}" IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Export matching puzzles to PGN…" Command="{x:Bind ViewModel.ExportFilteredPgnCommand}" IsEnabled="{x:Bind ViewModel.HasDatabase, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Export matching puzzles to CSV…" Command="{x:Bind ViewModel.ExportFilteredCsvCommand}" IsEnabled="{x:Bind ViewModel.HasDatabase, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Export played puzzles to PGN…" Command="{x:Bind ViewModel.ExportHistoryPgnCommand}" IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem Text="Start PGN at the player's move" IsChecked="{x:Bind ViewModel.PgnFromPlayerMove, Mode=TwoWay}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Grid.Column="1" Content="Lichess" IsEnabled="{x:Bind ViewModel.HasPuzzle, Mode=OneWay}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Open puzzle on lichess.org" Command="{x:Bind ViewModel.OpenOnLichessCommand}" />
                                        <MenuFlyoutItem Text="Open source game" Command="{x:Bind ViewModel.OpenGameCommand}" IsEnabled="{x:Bind ViewModel.HasGameUrl, Mode=OneWay}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress of long operations -->
        <Grid Grid.Row="2" Padding="16,10" ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind local:Ui.Show(ViewModel.IsBusy), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind ViewModel.BusyProgress, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelBusyCommand}" />
        </Grid>
    </Grid>
</Window>
