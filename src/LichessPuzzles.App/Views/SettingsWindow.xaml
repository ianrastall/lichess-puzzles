<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jupiter.LichessPuzzles.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" RequestedTheme="Dark">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,8,24,24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Appearance" />
                <RadioButtons x:Name="AccentChoice" Header="Accent color" SelectionChanged="OnAccentChoiceChanged">
                    <x:String>Use Windows accent color</x:String>
                    <x:String>Custom color</x:String>
                </RadioButtons>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AccentSwatchButton" AutomationProperties.Name="Choose custom accent color" ToolTipService.ToolTip="Choose custom accent color">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="AccentSwatch" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource JupiterSeparatorBrush}" />
                            <TextBlock Text="Choose color" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12">
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="Apply" Click="OnApplyCustomAccent" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Reset to Windows accent" Click="OnResetAccent" />
                </StackPanel>
                <TextBlock Style="{StaticResource ExplanationStyle}" Text="Applies immediately and is kept for this app only." />

                <ComboBox x:Name="BoardThemeBox" Header="Board" SelectionChanged="OnBoardThemeChanged" MinWidth="200" />
                <ToggleSwitch x:Name="CoordinatesSwitch" Header="Coordinates" Toggled="OnCoordinatesToggled" />
                <RadioButtons x:Name="AnimationChoice" Header="Move animation" SelectionChanged="OnAnimationChanged" MaxColumns="3">
                    <x:String>Off</x:String>
                    <x:String>Fast</x:String>
                    <x:String>Normal</x:String>
                </RadioButtons>
                <TextBlock Style="{StaticResource ExplanationStyle}" Text="Moves are not animated while Windows animation effects are turned off." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Puzzles" />
                <ToggleSwitch x:Name="ThemesSwitch" Header="Show themes while solving" Toggled="OnThemesToggled" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-8,0,0" Text="Themes can give the solution away; when off they are shown once the puzzle ends." />
                <NumberBox x:Name="DelayBox" Header="Opponent's move delay (seconds)" Minimum="0.3" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                           SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="OnDelayChanged" MaxWidth="240" HorizontalAlignment="Left" />
                <ToggleSwitch x:Name="AutoNextSwitch" Header="Go to the next puzzle after a clean solve" Toggled="OnAutoNextToggled" />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Evaluation" />
                <ToggleSwitch x:Name="EvaluationSwitch" Header="Enable evaluation" Toggled="OnEvaluationToggled" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-8,0,0" Text="A small built-in engine shows a score and its best line once the puzzle ends. It is a guide, not an authority." />
                <ToggleSwitch x:Name="EvaluationSolvingSwitch" Header="Show while solving" Toggled="OnEvaluationSolvingToggled" />
                <NumberBox x:Name="EvaluationTimeBox" Header="Time per position (seconds)" Minimum="0.5" Maximum="5" SmallChange="0.5" LargeChange="1"
                           SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="OnEvaluationTimeChanged" MaxWidth="240" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Storage" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Data folder" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DataFolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Show folder" Click="OnShowFolder" />
                </Grid>
                <ToggleSwitch x:Name="KeepDownloadSwitch" Header="Keep the downloaded file after building" Toggled="OnKeepDownloadToggled" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-8,0,0" Text="About 300 MB. It lets the store be rebuilt without downloading again. Applies to the next build." />
                <ToggleSwitch x:Name="CheckUpdatesSwitch" Header="Check for updates when the app starts" Toggled="OnCheckUpdatesToggled" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-8,0,0" Text="One request to database.lichess.org; nothing is downloaded without your choice." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
